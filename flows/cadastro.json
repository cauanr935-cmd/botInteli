{
  "version": "6.2",
  "screens": [
    {
      "id": "CADASTRO",
      "title": "Cadastro",
      "terminal": true,
      "success": true,
      "data": {},
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "form",
            "children": [
              {
                "type": "TextInput",
                "name": "full_name",
                "label": "Nome completo",
                "input-type": "text",
                "required": true,
                "min-chars": 2,
                "max-chars": 100
              },
              {
                "type": "OptIn",
                "name": "consent",
                "label": "Li e aceito o termo de uso dos meus dados (LGPD)",
                "required": true,
                "on-click-action": {
                  "name": "open_url",
                  "url": "https://example.com/politica-de-privacidade"
                }
              },
              {
                "type": "Footer",
                "label": "Enviar cadastro",
                "on-click-action": {
                  "name": "complete",
                  "payload": {
                    "full_name": "${form.full_name}",
                    "consent": "${form.consent}"
                  }
                }
              }
            ]
          }
        ]
      }
    }
  ]
}
